{
  "_description": "계산기 호출 결정을 모델에서 실행기로 옮기는 결정론적 대화 정책 계약 초안이다.",
  "schema_version": "0.1.0",
  "policy_id": "saju-dialogue-policy-v0.1.0",
  "status": "draft_diagnostic_only_not_runtime_approved",
  "principle": {
    "fsm_owns": "어떤 사실이 확정됐는지와 계산기 호출 시점",
    "model_owns": "무슨 말을 할지, 톤, 공감, 해석",
    "never": "FSM이 대화 문장을 생성하거나 모델이 provenance 필드를 만드는 것"
  },
  "required_slots": ["birth_date", "calendar", "birthplace"],
  "optional_slots": ["birth_time", "time_precision", "gender_for_daeun"],
  "states": [
    "no_birth_input",
    "partial_birth_input",
    "birth_input_ready",
    "chart_ready",
    "chart_invalidated"
  ],
  "actions": [
    "model_free_reply",
    "model_ask_missing_slot",
    "call_calculator",
    "model_grounded_reply",
    "model_limited_reply"
  ],
  "precedence": [
    "tool_status in {error, blocked, partial} -> model_limited_reply",
    "saju_intent == false -> model_free_reply",
    "chart_ready -> model_grounded_reply",
    "birth_input_ready | chart_invalidated -> call_calculator",
    "otherwise -> model_ask_missing_slot"
  ],
  "constraints": {
    "free_reply_v1": "사주를 먼저 꺼내지 않는다. 일반 대화로 응답한다.",
    "ask_missing_v1": "빠진 슬롯 하나만 자연스럽게 묻는다. 이미 받은 값은 다시 묻지 않는다.",
    "grounded_reply_v1": "hard_facts에 있는 값만 사실로 쓴다. 없는 간지를 만들지 않는다.",
    "limited_reply_v1": "확정되지 않은 부분을 명시한다. 완료된 것처럼 말하지 않는다."
  },
  "model_visible_projection": {
    "source": "scripts/runtime/calculation/bridge.execute_runtime_tool",
    "allowlist_owner": "configs/runtime/tool_schema_v1.json",
    "new_fields_allowed": false
  },
  "slot_extractor_candidates": {
    "rule": "정규식·규칙. 결정론적이나 표현 다양성에 약함",
    "model_narrow": "모델에게 추출만 시킴. 도구 호출 시점 판단보다 좁은 과제"
  },
  "scope": {
    "diagnostic_only": true,
    "modifies_ki20_artifacts": false,
    "sealed_blind_access": false,
    "changes_runtime_gate": false
  }
}
