{
  "_description": "과거 공식 근거 Skyfield 후보만 메모리 세션에 보관하고 release·기간 계산을 금지하는 구조화 intake 계약이다.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "2.2.0",
  "session_state_schema_version": "saju-session-state-v2.2",
  "fsm_version": "saju-intake-fsm-v1.2.0",
  "candidate_policy": {
    "scope": "historical_official_corroborated_only",
    "fact_authority": "HARD_CANDIDATE",
    "production_release_approved": false,
    "application_binding_performed": false,
    "period_calculation_allowed": false,
    "disk_persistence_allowed": false
  },
  "pii_at_rest": {
    "contains_birth_data": true,
    "hmac_is_encryption": false,
    "candidate_store": "bounded_process_memory_only",
    "production_persistence_allowed": false
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_schema_version": {"const": "saju-session-state-v2.2"},
    "fsm_version": {"const": "saju-intake-fsm-v1.2.0"},
    "saju_opt_in": {"type": "boolean"},
    "birth_slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "birth_date": {"type": ["string", "null"], "format": "date"},
        "calendar": {"type": ["string", "null"], "enum": ["solar", "lunar", null]},
        "leap_month": {"type": ["boolean", "null"]},
        "birth_time": {"type": ["string", "null"], "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
        "time_precision": {"type": ["string", "null"], "enum": ["exact", "range", "unknown", null]},
        "time_range": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
                "end": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"}
              },
              "required": ["start", "end"]
            }
          ]
        },
        "birthplace": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "country_code": {"const": "KR"},
                "city": {"type": "string", "minLength": 1},
                "timezone": {"const": "Asia/Seoul"},
                "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
                "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90}
              },
              "required": ["country_code", "city", "timezone", "longitude", "latitude"]
            }
          ]
        },
        "timezone": {"type": ["string", "null"], "enum": ["Asia/Seoul", null]},
        "gender_for_daeun": {"const": "unspecified"}
      },
      "required": [
        "birth_date", "calendar", "leap_month", "birth_time", "time_precision",
        "time_range", "birthplace", "timezone", "gender_for_daeun"
      ],
      "allOf": [
        {
          "if": {"properties": {"calendar": {"const": "solar"}}, "required": ["calendar"]},
          "then": {"properties": {"leap_month": {"const": null}}}
        },
        {
          "if": {"properties": {"leap_month": {"type": "boolean"}}, "required": ["leap_month"]},
          "then": {"properties": {"calendar": {"const": "lunar"}}}
        },
        {
          "if": {"properties": {"time_precision": {"const": "exact"}}, "required": ["time_precision"]},
          "then": {"properties": {"time_range": {"const": null}}}
        },
        {
          "if": {"properties": {"time_precision": {"const": "range"}}, "required": ["time_precision"]},
          "then": {"properties": {"birth_time": {"const": null}}}
        },
        {
          "if": {"properties": {"time_precision": {"const": "unknown"}}, "required": ["time_precision"]},
          "then": {"properties": {"birth_time": {"const": null}, "time_range": {"const": null}}}
        },
        {
          "if": {"properties": {"birthplace": {"const": null}}, "required": ["birthplace"]},
          "then": {"properties": {"timezone": {"const": null}}}
        }
      ]
    },
    "confirmed_fields": {
      "type": "array",
      "items": {"type": "string", "enum": ["birth_date", "calendar", "leap_month", "birth_time", "time_precision", "time_range", "birthplace"]},
      "uniqueItems": true
    },
    "explicit_unknown_fields": {
      "type": "array",
      "items": {"const": "birth_time"},
      "uniqueItems": true
    },
    "field_provenance": {
      "type": "object",
      "propertyNames": {"enum": ["birth_date", "calendar", "leap_month", "birth_time", "time_precision", "time_range", "birthplace", "timezone", "gender_for_daeun"]},
      "additionalProperties": {"type": "string", "enum": ["user_explicit", "deterministic_default", "derived_from_policy"]}
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chart_id": {"type": ["string", "null"], "pattern": "^sc2_[0-9a-f]{64}$"},
        "chart_set_id": {"type": ["string", "null"], "pattern": "^scs2_[0-9a-f]{64}$"},
        "chart_valid": {"type": "boolean"},
        "chart_input_fingerprint": {"type": ["string", "null"], "pattern": "^sif2_[0-9a-f]{64}$"},
        "hard_facts": {"type": ["object", "null"]},
        "fact_authority": {"type": ["string", "null"], "enum": ["HARD_CANDIDATE", null]}
      },
      "required": ["chart_id", "chart_set_id", "chart_valid", "chart_input_fingerprint", "hard_facts", "fact_authority"],
      "allOf": [
        {
          "if": {"properties": {"chart_valid": {"const": false}}, "required": ["chart_valid"]},
          "then": {
            "properties": {
              "chart_id": {"const": null},
              "chart_set_id": {"const": null},
              "chart_input_fingerprint": {"const": null},
              "hard_facts": {"const": null},
              "fact_authority": {"const": null}
            }
          }
        },
        {
          "if": {"properties": {"chart_valid": {"const": true}}, "required": ["chart_valid"]},
          "then": {
            "properties": {
              "chart_input_fingerprint": {"type": "string", "pattern": "^sif2_[0-9a-f]{64}$"},
              "hard_facts": {"type": "object"},
              "fact_authority": {"const": "HARD_CANDIDATE"}
            },
            "oneOf": [
              {"properties": {"chart_id": {"type": "string", "pattern": "^sc2_[0-9a-f]{64}$"}, "chart_set_id": {"const": null}}},
              {"properties": {"chart_id": {"const": null}, "chart_set_id": {"type": "string", "pattern": "^scs2_[0-9a-f]{64}$"}}}
            ]
          }
        }
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"request": {"const": null}, "result": {"const": null}},
      "required": ["request", "result"]
    },
    "current_intent": {"type": ["string", "null"], "enum": ["chart", "period", null]},
    "last_tool_status": {"type": ["string", "null"], "enum": ["partial", "blocked", "error", null]},
    "state_revision": {"type": "integer", "minimum": 0}
  },
  "required": [
    "session_schema_version", "fsm_version", "saju_opt_in", "birth_slots",
    "confirmed_fields", "explicit_unknown_fields", "field_provenance", "chart",
    "period", "current_intent", "last_tool_status", "state_revision"
  ]
}
