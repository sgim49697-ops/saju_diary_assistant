{
  "_description": "release 승인 뒤 exact와 불확실 입력의 사실 권위를 분리하는 내부 출력 계약이다.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saju-calculation-output-v1.1.0",
  "schema_version": "1.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {"type": "string", "enum": ["ok", "partial", "blocked", "error"]},
    "code": {"type": ["string", "null"]},
    "message": {"type": ["string", "null"]},
    "normalized_input": {"type": ["object", "null"]},
    "hard_facts": {"type": ["object", "null"]},
    "stable_facts": {"type": ["object", "null"]},
    "alternative_charts": {"type": "array", "items": {"type": "object"}},
    "uncertainty": {"type": ["object", "null"]},
    "fact_authority": {"type": ["string", "null"], "enum": ["HARD_GT", "POLICY_BOUND_RULE", null]},
    "birth_input_id": {"type": ["string", "null"]},
    "chart_id": {"type": ["string", "null"]},
    "chart_set_id": {"type": ["string", "null"]},
    "calculation_run_id": {"type": ["string", "null"]},
    "engine_version": {"const": "saju-runtime-python-v1.1.0"},
    "calculation_schema_version": {"const": "1.1.0"},
    "policy_id": {"const": "KR_CIVIL_MIDNIGHT_V1"},
    "source_versions": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "internal_trace": {"type": ["object", "null"]}
  },
  "required": [
    "status",
    "code",
    "message",
    "normalized_input",
    "hard_facts",
    "stable_facts",
    "alternative_charts",
    "uncertainty",
    "fact_authority",
    "birth_input_id",
    "chart_id",
    "chart_set_id",
    "calculation_run_id",
    "engine_version",
    "calculation_schema_version",
    "policy_id",
    "source_versions",
    "warnings",
    "limitations",
    "internal_trace"
  ]
}
