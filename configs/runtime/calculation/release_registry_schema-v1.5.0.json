{
  "_description": "conformance v10 통과 보고서와 원국+단일 일진 v1.5 운영 조건을 결합하는 release schema다.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saju-runtime-release-registry-v1.5.0",
  "schema_version": "1.5.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "release_id": {"type": "string", "pattern": "^saju-runtime-release-v1\\.5\\.0-[0-9a-f]{12}$"},
    "status": {"const": "approved_chart_and_single_day_feature_default_off"},
    "engine_version": {"const": "saju-runtime-python-v1.5.0"},
    "id_contract_version": {"const": "saju-runtime-id-hmac-v2.0.0"},
    "profile_id": {"const": "KR_CIVIL_MIDNIGHT_V1"},
    "approval_scope": {"const": "PAST_OFFICIAL_CHART_PLUS_SINGLE_DAY_1920_2049"},
    "approved_tools": {"const": ["calculate_saju_chart", "calculate_saju_period"]},
    "blocked_tools": {"const": []},
    "approved_solar_date_range": {"const": {"minimum": "1920-01-07", "maximum": "2026-08-31"}},
    "approved_single_day_range": {"const": {"minimum": "2026-09-02", "maximum": "2049-12-31"}},
    "single_day_evaluation_local_time": {"const": "12:00"},
    "single_day_dates": {"const": 8522},
    "single_day_label_mismatches": {"const": 0},
    "noon_boundary_quarantine_dates": {"const": 0},
    "parent_v1_4_release": {"type": "object"},
    "runtime_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conformance_report": {"type": "object"},
    "official_snapshots": {"type": "object"},
    "implementation_sha256": {"type": "object"},
    "production_id_key_required": {"const": true},
    "runtime_feature_flag_default": {"const": false},
    "strict_runtime_provider_gate_passed": {"const": false},
    "full_runtime_gate_passed": {"const": false},
    "production_application_binding": {"const": false},
    "mix20k_v3_1_regeneration_allowed": {"const": false},
    "training_promotion_allowed": {"const": false},
    "sealed_blind_accessed": {"const": false}
  },
  "required": [
    "release_id", "status", "engine_version", "id_contract_version", "profile_id",
    "approval_scope", "approved_tools", "blocked_tools", "approved_solar_date_range",
    "approved_single_day_range", "single_day_evaluation_local_time", "single_day_dates",
    "single_day_label_mismatches", "noon_boundary_quarantine_dates", "parent_v1_4_release",
    "runtime_registry_sha256", "conformance_report", "official_snapshots",
    "implementation_sha256", "production_id_key_required", "runtime_feature_flag_default",
    "strict_runtime_provider_gate_passed", "full_runtime_gate_passed",
    "production_application_binding", "mix20k_v3_1_regeneration_allowed",
    "training_promotion_allowed", "sealed_blind_accessed"
  ]
}
