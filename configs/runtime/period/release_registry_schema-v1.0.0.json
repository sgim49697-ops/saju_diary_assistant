{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saju-period-daily-label-release-registry-v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "status",
    "parent_runtime_release",
    "contract_registry_sha256",
    "conformance_report",
    "feature_flag_default",
    "strict_full_runtime_approved",
    "training_promotion_allowed",
    "sealed_blind_accessed"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "pattern": "^saju-period-daily-label-release-v1\\.0\\.0-[0-9a-f]{12}$"},
    "status": {"const": "approved_daily_labels_feature_default_off"},
    "parent_runtime_release": {"const": "saju-runtime-release-v1.5.0-8b1d6ea2d46e"},
    "contract_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conformance_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_id", "path", "sha256", "manifest_path", "manifest_sha256"],
      "properties": {
        "build_id": {"type": "string", "pattern": "^build-[0-9a-f]{12}$"},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_path": {"type": "string"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "feature_flag_default": {"const": false},
    "strict_full_runtime_approved": {"const": false},
    "training_promotion_allowed": {"const": false},
    "sealed_blind_accessed": {"const": false}
  }
}
