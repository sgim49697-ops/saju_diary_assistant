{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saju-period-resolved-scope-v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date_expression",
    "start_date",
    "end_date",
    "day_count",
    "timezone",
    "evaluation_local_time",
    "reference_date",
    "intraday_segments_supported",
    "future_physical_instant_claimed"
  ],
  "properties": {
    "schema_version": {"const": "saju-period-resolved-scope-v1"},
    "date_expression": {
      "enum": ["today", "tomorrow", "this_weekend", "this_week", "this_month", "explicit"]
    },
    "start_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "end_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "day_count": {"type": "integer", "minimum": 1, "maximum": 31},
    "timezone": {"const": "Asia/Seoul"},
    "evaluation_local_time": {"const": "12:00"},
    "reference_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "intraday_segments_supported": {"const": false},
    "future_physical_instant_claimed": {"const": false}
  }
}
