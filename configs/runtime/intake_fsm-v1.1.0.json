{
  "_description": "중복 없는 session v2.1과 의미 검증·재생 방지를 결합한 구조화 사주 intake FSM 계약이다.",
  "schema_version": "1.1.0",
  "fsm_version": "saju-intake-fsm-v1.1.0",
  "session_state_schema_version": "saju-session-state-v2.1",
  "input_mode": "structured_events_only",
  "free_text_parser_in_fsm": false,
  "event_types": [
    "opt_in", "set_slot", "correct_slot", "set_time_unknown", "request_chart",
    "chart_result", "request_period", "period_result", "reset"
  ],
  "decision_actions": [
    "ask_birth_date", "ask_calendar", "ask_leap_month", "ask_time_precision",
    "ask_exact_time_or_range", "ask_birthplace", "call_chart",
    "explain_runtime_blocked", "call_period", "render_result"
  ],
  "never_request_slots": ["name", "family_relationship", "job", "gender_for_daeun"],
  "deterministic_defaults": {"gender_for_daeun": "unspecified"},
  "unknown_time_policy": "valid_partial_input_without_representative_time",
  "state_semantic_policy": "slot_confirmation_provenance_precision_and_authority_must_agree",
  "correction_policy": "invalidate_chart_period_and_hmac_fingerprint",
  "tool_result_policy": "accept_only_when_current_hmac_call_id_matches_and_reject_stale_or_rendered_result_replay",
  "result_policy": "render_only_structured_tool_result_never_claim_hidden_ui_or_completion",
  "app_preconditions": [
    "runtime_release_ready", "feature_enabled", "production_id_key_ready",
    "fsm_gate_passed", "encrypted_persistence_ready", "retention_policy_ready"
  ],
  "model_gate_is_replaced": false
}
